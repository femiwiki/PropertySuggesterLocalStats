{
	"name": "PropertySuggesterLocalStats",
	"version": "0.1.0",
	"author": "[https://femiwiki.com/ Femiwiki Team]",
	"url": "https://github.com/femiwiki/PropertySuggesterLocalStats",
	"descriptionmsg": "propertysuggesterlocalstats-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "wikibase",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PropertySuggesterLocalStats\\": "src/",
		"MediaWiki\\Extension\\PropertySuggesterLocalStats\\Maintenance\\": "maintenance/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\PropertySuggesterLocalStats\\Tests\\": "tests/phpunit/"
	},
	"MessagesDirs": {
		"PropertySuggesterLocalStats": ["i18n"]
	},
	"ServiceWiringFiles": ["src/ServiceWiring.php"],
	"JobClasses": {
		"propertySuggesterLocalStatsRebuild": "MediaWiki\\Extension\\PropertySuggesterLocalStats\\RebuildJob"
	},
	"config": {
		"PropertySuggesterLocalStatsMinProbability": {
			"value": 0.01,
			"description": "Pairs at or below this probability are not written, as property-suggester-scripts does"
		}
	},
	"manifest_version": 2
}
